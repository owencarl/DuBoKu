# StreamPulse Environment Configuration

# 4-Digit Access PIN for family members (defaults to 1234 if unset)
FAMILY_PIN=1234

# Optional: High-Bandwidth Cloudflare Worker Proxy URL (Unlimited free bandwidth)
# Offloads 100% of video streaming from Vercel to eliminate Fast Origin Transfer quota limits.
# See cloudflare-worker/README.md for the 2-minute setup guide.
STREAM_PROXY_URL=https://streampulse-proxy.yourname.workers.dev
NEXT_PUBLIC_STREAM_PROXY_URL=https://streampulse-proxy.yourname.workers.dev

# Port configuration (for local/Docker deployment, Vercel sets this automatically)
PORT=3000
